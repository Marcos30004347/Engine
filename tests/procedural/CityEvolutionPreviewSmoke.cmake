# This directory is owned exclusively by this smoke test.
file(REMOVE_RECURSE "${OUTPUT}")
execute_process(COMMAND "${PREVIEW}" "${OUTPUT}" 1 --no-mesh --no-activities
  RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE detail TIMEOUT 110)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "history preview failed: ${code}: ${detail}")
endif()
set(snapshot "${OUTPUT}/year-1/settlement-100/history.json")
if(NOT EXISTS "${snapshot}")
  message(FATAL_ERROR "history preview did not export the requested milestone")
endif()
if(EXISTS "${OUTPUT}/year-1/settlement-100/city-model.json")
  message(FATAL_ERROR "--no-mesh was ignored")
endif()
file(READ "${snapshot}" history)
string(JSON schema GET "${history}" schemaVersion)
string(JSON circuits TYPE "${history}" defenceCircuits)
string(JSON minute TYPE "${history}" activityMinute)
if(NOT schema EQUAL 2 OR NOT circuits STREQUAL "ARRAY" OR NOT minute STREQUAL "NULL")
  message(FATAL_ERROR "history schema or preview flags were not preserved")
endif()
